{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "src-tauri",
  "version": "0.1.0",
  "identifier": "alexmarpar.github.io.opensentinel",
  "build": {
    "frontendDist": "../client/dist",
    "devUrl": "http://localhost:5173/",
    "beforeDevCommand": "pnpm --dir client run dev",
    "beforeBuildCommand": "pnpm --dir client run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenSentinel",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "externalBin": [
      "binaries/backend"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
